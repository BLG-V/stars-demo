# Replace the two certificate placeholders with paths reported by `certbot certificates`.
# Do not install this template unchanged.
server {
    listen 80;
    server_name 39.107.41.101;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name 39.107.41.101;

    ssl_certificate __STARS_FULLCHAIN_PEM__;
    ssl_certificate_key __STARS_PRIVKEY_PEM__;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /opt/stars-demo-release/dist;
    index index.html;
    client_max_body_size 512k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 210s;
        proxy_send_timeout 210s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
