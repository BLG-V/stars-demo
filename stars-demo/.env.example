# Local API configuration
PORT=8787
STARS_STORAGE=json
STARS_DATA_FILE=./data/stars.json
# Keep false until a real model provider is configured.
ALLOW_STUB_MODEL=false
# OpenAI-compatible Chat Completions provider. Keep all credentials on the server.
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_API_KEY=replace-me
# MODEL_NAME=qwen3.8-flash
# MODEL_TIMEOUT_MS=60000
# Registration email verification (required for production signup)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true (or ssl)
# SMTP_USER=stars@example.com
# SMTP_PASSWORD=replace-me
# SMTP_FROM=Stars <stars@example.com>
# Opt in to MySQL after setting up the included migrations. Never commit production credentials.
# STARS_STORAGE=mysql
# DATABASE_URL=mysql://stars_app:change-me@127.0.0.1:3306/stars
# Production registration requires a real SMTP provider. Never expose these in frontend variables.
# REQUIRE_EMAIL_VERIFICATION=true
# Cloudflare Turnstile (required for auth when TURNSTILE_REQUIRED=true)
# TURNSTILE_SITE_KEY=0x4AAAAAA...
# TURNSTILE_SECRET_KEY=replace-me
# TURNSTILE_REQUIRED=false
